[
  {
    "start": 10.73,
    "end": 13.81534375,
    "text": "On my way uptown, I count the doors."
  },
  {
    "start": 16.03,
    "end": 18.69134375,
    "text": "The window keeps my face for a while."
  },
  {
    "start": 22.13,
    "end": 25.05734375,
    "text": "I can tell how late I am by the roofs."
  },
  {
    "start": 29.23,
    "end": 32.91534375,
    "text": "At the coffee cart, I watch the light across the street."
  },
  {
    "start": 37.43,
    "end": 39.9,
    "text": "When it changes, I go."
  },
  {
    "start": 43.53,
    "end": 46.9166875,
    "text": "At the top of the steps, the brass door is open."
  },
  {
    "start": 50.93,
    "end": 53.4,
    "text": "Lucky, I think."
  },
  {
    "start": 57.93,
    "end": 61.338,
    "text": "In my notebook the whole trip fits on one line."
  },
  {
    "start": 63.93,
    "end": 66.4,
    "text": "Brooklyn. Then class."
  },
  {
    "start": 75.93,
    "end": 78.954,
    "text": "What did I put in the space between those words?"
  },
  {
    "start": 85.93,
    "end": 88.44200000000001,
    "text": "Same corner. Same light."
  },
  {
    "start": 95.93,
    "end": 98.4,
    "text": "There it is again."
  },
  {
    "start": 102.93,
    "end": 105.84734375,
    "text": "A spoon touches the rim. Twice."
  },
  {
    "start": 111.93,
    "end": 114.8686875,
    "text": "There's another cup behind the one I took."
  },
  {
    "start": 119.53,
    "end": 122.63934375,
    "text": "The door hangs open for the length of a breath."
  },
  {
    "start": 129.03,
    "end": 132.054,
    "text": "Someone's hand is still on the other side."
  },
  {
    "start": 139.13,
    "end": 142.52321874999998,
    "text": "I remember the brass. I don't remember the hand."
  },
  {
    "start": 149.33,
    "end": 152.1984375,
    "text": "If you ask how long it takes to get here,"
  },
  {
    "start": 155.13,
    "end": 157.6,
    "text": "give me a minute."
  }
]
