{
  "name": "one-city-may-hide-another",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A code-generated New York poetry film and an interactive Three.js railway set.",
  "scripts": {
    "art": "node scripts/plates.mjs",
    "prestudio": "npm run art",
    "studio": "node scripts/frames.mjs && remotion studio src/index.tsx",
    "rail": "node scripts/rail.mjs explore",
    "bake:rail": "node scripts/rail.mjs bake",
    "bundle:rail": "node scripts/rail.mjs bundle",
    "bundle:corner": "esbuild src/corner-world.js --bundle --minify --format=esm --target=es2020 --legal-comments=inline --outfile=docs/assets/corner-engine.js",
    "sound": "python3 scripts/sound.py",
    "prerender": "npm run art",
    "render": "node scripts/render.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.409",
    "@remotion/cli": "4.0.409",
    "@remotion/renderer": "4.0.409",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.409",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "esbuild": "0.25.12",
    "playwright-core": "1.55.0",
    "sharp": "0.34.3",
    "typescript": "5.7.3"
  }
}
